{
  "name": "openos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenOS — Generate Everything, Create Infinite. AI desktop OS shell that generates apps on demand (Electron + TypeScript).",
  "author": "OpenOS Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seekskyworld/openos.git"
  },
  "bugs": {
    "url": "https://github.com/seekskyworld/openos/issues"
  },
  "homepage": "https://github.com/seekskyworld/openos#readme",
  "main": "desktop/dist/main.cjs",
  "workspaces": [
    "desktop",
    "server",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run desktop:dev",
    "dev:server": "npm run dev -w @openos/server",
    "dev:web": "npm run dev -w @openos/web",
    "dev:web-stack": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "build": "npm run build -w @openos/shared && npm run build -w @openos/server && npm run build -w @openos/web && npm run build -w @openos/desktop",
    "build:shared": "npm run build -w @openos/shared",
    "build:server": "npm run build -w @openos/server",
    "build:web": "npm run build -w @openos/web",
    "build:desktop": "npm run build -w @openos/desktop",
    "desktop:dev": "npm run build:shared && npm run build:desktop && node scripts/launch-desktop-dev.mjs --web-dev",
    "desktop:dev:static": "npm run build && node scripts/launch-desktop-dev.mjs",
    "desktop:pack": "npm run build && node scripts/package-desktop.mjs --dir",
    "desktop:dist": "npm run build && node scripts/package-desktop.mjs",
    "smoke:desktop-package": "node scripts/smoke-desktop-package.mjs",
    "start:server": "npm run start -w @openos/server",
    "presmoke:genapps-v2": "npm run build -w @openos/shared && npm run build -w @openos/server",
    "smoke:genapps-v2": "node scripts/smoke-gen-apps-v2.mjs",
    "presmoke:genapps-runtime": "npm run build -w @openos/shared",
    "smoke:genapps-runtime": "node scripts/smoke-gen-app-runtime.mjs",
    "presmoke:genapps-games": "npm run build -w @openos/shared",
    "smoke:genapps-games": "node scripts/smoke-gen-app-games.mjs",
    "typecheck": "npm run typecheck -w @openos/shared && npm run typecheck -w @openos/server && npm run typecheck -w @openos/web && npm run typecheck -w @openos/desktop"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.openos.desktop",
    "productName": "OpenOS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "LICENSE",
      "NOTICE",
      "docs/third-party-licenses.md",
      "desktop/dist/**/*",
      "!desktop/dist/**/*.map",
      "web/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/logo.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Utility",
      "icon": "assets/logo.png",
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "icon": "assets/logo.png",
      "target": [
        "nsis"
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}

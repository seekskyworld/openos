# 仅服务端读取；不要写进前端或仓库
# 也可在 UI Settings 中配置（优先于下列 env）
OPENOS_LLM_PROVIDER=openai
OPENOS_LLM_BASE_URL=https://api.openai.com/v1
OPENOS_LLM_API_KEY=
OPENOS_LLM_MODEL=gpt-4o-mini
# provider 可选: openai | anthropic | google | xai | mistral | groq | deepinfra |
#   cerebras | togetherai | openrouter | deepseek | fireworks | openai-compatible

# 也可直接用各厂商标准 env（设置页未写密钥时会自动读取）
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=

# 可选：桌面桥接认证（stable 打包后默认强制 token）
# OPENOS_BRIDGE_TOKEN=
